# Template fuer /home/admin/agh-sync/.env auf dem VPS.
# Echte Werte einsetzen, dann `chmod 600 .env` und Repo lassen.

# Master: VPS-AGH
ORIGIN_URL=http://100.92.62.9:3000
ORIGIN_USERNAME=CHANGEME
ORIGIN_PASSWORD=CHANGEME

# Replica: CachyOS-AGH (Tailscale-IP)
REPLICA1_URL=http://100.95.132.54:3000
REPLICA1_USERNAME=CHANGEME
REPLICA1_PASSWORD=CHANGEME

# Sync-Verhalten
CRON=*/5 * * * *
RUN_ON_START=true

# Welche Sektionen werden synchronisiert
FEATURES_FILTERS=true
FEATURES_CLIENTS=true
FEATURES_DNS_SERVER_CONFIG=true
FEATURES_DNS_REWRITES=true

# Sektionen, die pro Knoten lokal bleiben sollen
FEATURES_GENERAL_SETTINGS=false
FEATURES_QUERY_LOG_CONFIG=false
FEATURES_STATS_CONFIG=false
FEATURES_SERVICES=false
