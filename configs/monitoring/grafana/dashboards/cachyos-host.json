{
  "dashboard": {
    "uid": "cachyos-host",
    "title": "CachyOS Host",
    "tags": ["homelab", "node_exporter"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "30s",
    "time": { "from": "now-1h", "to": "now" },
    "panels": [
      {
        "id": 1,
        "type": "timeseries",
        "title": "CPU %",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "cfmoy44jnnv28b" },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
            "legendFormat": "CPU",
            "datasource": { "type": "prometheus", "uid": "cfmoy44jnnv28b" }
          }
        ]
      },
      {
        "id": 2,
        "type": "timeseries",
        "title": "RAM verfügbar (GB)",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "cfmoy44jnnv28b" },
        "fieldConfig": {
          "defaults": { "unit": "decgbytes" }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "node_memory_MemAvailable_bytes / 1024 / 1024 / 1024",
            "legendFormat": "Available",
            "datasource": { "type": "prometheus", "uid": "cfmoy44jnnv28b" }
          }
        ]
      },
      {
        "id": 3,
        "type": "timeseries",
        "title": "Disk Write (MB/s)",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
        "datasource": { "type": "prometheus", "uid": "cfmoy44jnnv28b" },
        "fieldConfig": {
          "defaults": { "unit": "MBs" }
        },
        "targets": [
          {
            "refId": "A",
            "expr": "rate(node_disk_written_bytes_total[1m]) / 1024 / 1024",
            "legendFormat": "{{device}}",
            "datasource": { "type": "prometheus", "uid": "cfmoy44jnnv28b" }
          }
        ]
      }
    ]
  },
  "overwrite": true,
  "message": "Initial dashboard from homelab repo"
}
